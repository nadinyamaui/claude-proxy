# --- server ---
PORT=8787
# Bind to 127.0.0.1 unless you really mean to expose the proxy.
HOST=127.0.0.1

# Shared secret required in the `authorization: Bearer <token>` header.
# Leave unset to disable auth (local use only).
PROXY_TOKEN=

# Directory the CLIs run in.
WORKDIR=

# Max time a single CLI invocation may run, and max request body size.
TIMEOUT_MS=120000
MAX_BODY_BYTES=1000000

# --- background runs (POST /runs) ---
# Each run gets its own working directory under RUNS_DIR; the SQLite database
# holding runs and their logs defaults to RUNS_DIR/runs.sqlite.
RUNS_DIR=runs
RUNS_DB=

# Background runs are long-lived agent sessions; this is their own timeout.
RUN_TIMEOUT_MS=3600000

# Max multipart upload (the zip plus fields) and max size the zip may expand to.
MAX_UPLOAD_BYTES=100000000
MAX_UNZIP_BYTES=1000000000

# How many background runs may execute at once; the rest wait in a queue.
MAX_CONCURRENT_RUNS=2

# --- provider binaries ---
CLAUDE_BIN=claude
CODEX_BIN=codex
GROK_BIN=grok
